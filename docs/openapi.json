  "components": {
    "schemas": {
      "ActiveInput": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "active"
        ],
        "title": "ActiveInput"
      },
      "CategoryInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CategoryInput"
      },
      "ConversationTurn": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 4000,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "ConversationTurn"
      },
      "Feedback": {
        "properties": {
          "helpful": {
            "type": "boolean",
            "title": "Helpful"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "helpful"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "NoticeInput": {
        "properties": {
          "service_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Service Id"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 2,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 2,
            "title": "Body"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ends At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service_id",
          "title",
          "body",
          "starts_at",
          "ends_at"
        ],
        "title": "NoticeInput"
      },
      "Question": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Text"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            },
            "type": "array",
            "maxItems": 3,
            "title": "History"
